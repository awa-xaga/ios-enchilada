 #define SYN_TLMM_PA     0x03400000u
+/* sdm845 TLMM is tiled: NORTH at +0x500000, SOUTH at +0x900000, 0x1000 per
+ * pin (sdm845-pinctrl.dtsi maps 0xc00000, but one ml_io_map of that size
+ * panics in kmem_alloc_contig - map the two tiles we need separately). */
+#define SYN_TILE_NORTH  0x00500000u
+#define SYN_TILE_SOUTH  0x00900000u
+#define SYN_TILE_SIZE   0x00100000u
 #define SYN_I2C_ADDR    0x20u
 #define SYN_F12_MAP     0xDDu
 #define SYN_F01_MAP     0xE3u
 
+/* The S3320 pins are 49/50 (I2C, qup12), 99 (reset) and 125 (irq) in NORTH,
+ * 88 (1v8 enable) in SOUTH; the offset is pin * 0x1000 within the tile. */
+static vm_offset_t
+syn_gpio_base(unsigned pin)
+{
+	return (pin == 88) ? st.gpio_s : st.gpio;
+}
+
+static void
+syn_gpio(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out, bool high)
+{
+	vm_offset_t base = syn_gpio_base(pin);
+	uint32_t off = pin * 0x1000u;
+	uint32_t cfg = touch_rd(base, off);
+	if (out) {
+		touch_wr(base, off + 4u, (touch_rd(base, off + 4u) & ~2u) | (high ? 2u : 0u));
+	}
+	cfg &= ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	touch_wr(base, off, cfg);
+}
+
+static uint32_t
+syn_gpio_cfg(unsigned pin)
+{
+	return touch_rd(syn_gpio_base(pin), pin * 0x1000u);
+}
+
+static uint32_t
+syn_gpio_io(unsigned pin)
+{
+	return touch_rd(syn_gpio_base(pin), pin * 0x1000u + 4u);
+}
