+/* The APCS watchdog pet thread (sweet_keys.c) dies with a panic, so a panic
+ * screen only lives until the next bark (~11 s). Re-arm the reset-off state
+ * once from here and keep the panic on screen; then try to persist the ring
+ * so the panic is still readable after the SoC is reset by hand. */
+extern vm_offset_t sweet_wdt_regs;
+
+static volatile int sweet_log_panic_done;
+
+static void
+sweet_log_panic_flush(void)
+{
+	uint64_t base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+
+	if (sweet_wdt_regs) {
+		*(volatile uint32_t *)(sweet_wdt_regs + 0x04) = 1;	/* WDT0_RST */
+		*(volatile uint32_t *)(sweet_wdt_regs + 0x08) = 0;	/* WDT0_EN */
+		*(volatile uint32_t *)(sweet_wdt_regs + 0x38) = 1;	/* APCS_TMR RST */
+		*(volatile uint32_t *)(sweet_wdt_regs + 0x40) = 0;	/* APCS_TMR EN */
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	if (!su.writable || total == 0 || !lck_mtx_try_lock(&sweet_ufs_lock)) {
+		return;
+	}
+	uint64_t pos = total > SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : 0;
+	int error = 0;
+	while (pos < total && !error) {
+		uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
+		uint32_t blk = off / UFS_BLOCK;
+		uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+		uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
+		    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+		memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+		error = ufs_write_blocks(base + 1 + blk, n);
+		pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+	}
+	if (!error) {
+		struct sweet_log_header h;
+		bzero(bounce, UFS_BLOCK);
+		memcpy(h.magic, "SWEETLOG", 8);
+		h.version = 1;
+		h.size = SWEET_LOG_SIZE;
+		h.total = total;
+		h.seq = 0x900d0000u;	/* marks a panic-time write */
+		memcpy(bounce, &h, sizeof(h));
+		error = ufs_write_blocks(base, 1);
+	}
+	if (!error) {
+		(void)ufs_sync_cache();
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+}
