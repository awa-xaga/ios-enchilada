+/* Sleep in a kernel thread (keys_wait is the fixed 20 ms variant). */
+static void
+keys_sleep(int ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&keys_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+
+/* No touch driver yet: optionally unlock the iPhone X lock screen with a
+ * synthetic swipe from the bottom edge. sweetswipetest=N waits N seconds. */
+static void
+sweet_swipe_thread(void *arg, wait_result_t result)
+{
+	int secs = (int)(uintptr_t)arg;
+	(void)result;
+	for (int i = 0; i < secs; i++) {
+		keys_sleep(1000);
+	}
+	printf("SWEET HID: synthetic unlock swipe (panel 1080x2280)\n");
+	sweet_hid_touch(0, 1, 540, 2250);
+	for (int i = 1; i <= 20; i++) {
+		sweet_hid_touch(0, 1, 540, 2250 - i * 75);
+		keys_sleep(20);
+	}
+	sweet_hid_touch(0, 0, 540, 750);
+}
