+/* No touch driver yet: optionally unlock the iPhone X lock screen with a
+ * synthetic bottom-edge swipe. sweetswipetest=N waits N seconds. */
+static void
+sweet_swipe_thread(void *arg, wait_result_t result)
+{
+	int secs = (int)(uintptr_t)arg;
+	(void)result;
+	for (int i = 0; i < secs; i++) {
+		keys_sleep(1000);
+	}
+	printf("SWEET HID: synthetic unlock swipe (panel 1080x2280)\n");
+	sweet_hid_touch(0, 1, 540, 2200);
+	for (int i = 1; i <= 20; i++) {
+		sweet_hid_touch(0, 1, 540, 2200 - i * 70);
+		keys_sleep(20);
+	}
+	sweet_hid_touch(0, 0, 540, 800);
+}
